{
  "Engine": {
    "multiThreading": false,
    "profileCsv": true,
    "logStats": true,
    "logErrors": true
  },
  "Window": {
    "width": 1280,
    "height": 720,
    "fullscreen": false,
    "title": "XEngine Benchmark - single"
  },
  "Renderer": {
    "vsync": false,
    "hardwareAcceleration": true,
    "backend": {
      "windows": "auto",
      "linux": "auto"
    },
    "backendFallback": true,
    "parallelPreparation": false,
    "parallelMinCommands": 1536,
    "bgColor": [
      11,
      16,
      27,
      255
    ],
    "parallelSelection": "fixed"
  },
  "Input": {
    "startTextInput": false,
    "startMouseLocked": false,
    "startMouseHidden": false
  },
  "Time": {
    "fixedDt": 0.016666666666666666
  },
  "Assets": {
    "assetsFolderPath": "./",
    "defaultFontRelativePath": "fonts/ui-default.ttf"
  },
  "Sound": {
    "sfxChannels": 16,
    "masterVolume": 0.8,
    "enableDucking": false,
    "duckVolume": 0.6,
    "duckAttackSec": 0.02,
    "duckReleaseSec": 0.25
  },
  "UIStyle": {
    "defaultFontKey": "ui_default",
    "defaultFontPtSize": 22
  },
  "Collision": {
    "broadphase": "bruteforce",
    "cellSize": 2.0
  },
  "Physics": {
    "baseGravity": [
      0,
      0
    ],
    "penetrationSlop": 0.01,
    "penetrationPercent": 0.8,
    "maxSubsteps": 1,
    "ccdMinSizeFactor": 0.5
  }
}
