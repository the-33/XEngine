#!/bin/sh
# Opt-in local hook: sync tracked games, then refresh Doxygen if needed.
root=$(git rev-parse --show-toplevel) || exit 1
if command -v py >/dev/null 2>&1; then
    set -- py -3
elif command -v python3 >/dev/null 2>&1; then
    set -- python3
elif command -v python >/dev/null 2>&1; then
    set -- python
else
    echo '[ERROR] Python 3 required for XEngine pre-commit hook' >&2
    exit 1
fi

"$@" "$root/tools/sync_game_gitignore.py" --stage --quiet || exit $?
exec "$@" "$root/tools/build_doxygen_if_staged.py"
