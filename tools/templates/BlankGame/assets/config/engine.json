{
  "Engine": {
    "multiThreading": false,
    "profileCsv": false,
    "logStats": true,
    "logErrors": true
  },
  "Window": {
    "width": 1280,
    "height": 720,
    "fullscreen": false,
    "title": "{{PROJECT_NAME}}"
  },
  "Renderer": {
    "vsync": true,
    "hardwareAcceleration": true,
    "parallelPreparation": true,
    "parallelMinCommands": 1536,
    "bgColor": [
      24,
      24,
      36,
      255
    ],
    "parallelSelection": "fixed"
  },
  "Input": {
    "startTextInput": false,
    "startMouseLocked": false,
    "startMouseHidden": false
  },
  "Time": {
    "fixedDt": 0.0166666667
  },
  "Assets": {
    "assetsFolderPath": "./",
    "defaultFontRelativePath": "fonts/ui-default.ttf"
  },
  "Sound": {
    "sfxChannels": 16,
    "masterVolume": 0.8,
    "enableDucking": false,
    "duckVolume": 0.6,
    "duckAttackSec": 0.02,
    "duckReleaseSec": 0.25
  },
  "UIStyle": {
    "defaultFontKey": "",
    "defaultFontPtSize": 18
  },
  "Collision": {
    "broadphase": "auto",
    "cellSize": "auto"
  },
  "Physics": {
    "baseGravity": [
      0,
      9.81
    ],
    "penetrationSlop": 0.01,
    "penetrationPercent": 0.8,
    "maxSubsteps": 8,
    "ccdMinSizeFactor": 0.5
  }
}
