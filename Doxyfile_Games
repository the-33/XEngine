# XEngine Game Developer API. Run `python tools/build_doxygen.py` for both audiences.
PROJECT_NAME           = "XEngine"
PROJECT_BRIEF          = "Game Developer Reference | C++20 / SDL2"
# Injected from root VERSION by tools/build_doxygen.py for both references.
PROJECT_NUMBER         = "$(XENGINE_VERSION)"
OUTPUT_DIRECTORY       = build/docs/game
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
DOXYFILE_ENCODING      = UTF-8
INPUT_ENCODING         = UTF-8
# Selected current manuals are useful to game developers too. Engine-only
# internals and historical benchmark reports are deliberately excluded.
INPUT                  = engine/include docs/reference/game \
                         docs/DEVELOPER_GUIDE.md docs/API_REFERENCE.md \
                         docs/GETTING_STARTED.md docs/GITHUB_PAGES.md \
                         docs/INCLUDES_AND_DEPENDENCIES.md docs/WINDOW_AND_CAMERA.md \
                         docs/PERSISTENCE_AND_SERIALIZATION.md \
                         docs/CROSS_COMPILATION.md docs/DEFAULT_GAME_ICONS.md \
                         docs/GAME_CONFIG_SYNC.md docs/GAME_GIT_TRACKING.md \
                         docs/ENGINE_CONFIG_MIGRATION.md docs/RENDER_BACKENDS.md \
                         docs/VERSIONING.md docs/VSCODE_INTEGRATION.md \
                         docs/MULTITHREADING_AND_PROFILING.md \
                         docs/RENDER_DIAGNOSTICS.md docs/BENCHMARK_GAME.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.md
EXCLUDE                = engine/include/AdaptiveBroadphase.h \
                         engine/include/ParallelExecutor.h \
                         engine/include/RenderPreparation.h \
                         engine/include/RendererBackendPolicy.h \
                         engine/include/SpatialContextClassifier.h \
                         engine/include/SpatialHashBroadphase.h \
                         engine/include/SpriteProjection.h \
                         engine/include/StatsOverlayLayout.h
# Nested private implementation records are not engine API, even if their
# implementation uses `struct` and Doxygen can see their member declarations.
EXCLUDE_SYMBOLS        = Engine::Config Engine::Config::* Engine::FrameProfile \
                         Engine::StatsDisplayRow \
                         UIManager::UIStyle UIManager::DrawCmd UIManager::ButtonState \
                         RenderManager::BackendCandidate RenderManager::DebugCmd \
                         RenderManager::Config RenderManager::TextCacheEntry \
                         WindowManager::Config SoundManager::Config \
                         PhysicsManager::Config CollisionManager::PairInfo \
                         InputManager::Config SceneManager::Entry CollisionManager::MinAxisResult \
                         XSerializationDetail XSerializationDetail::* detail detail::* \
                         *::*Prop *::*Property \
                         Component::m* Component::Start_ Component::Awake_ \
                         Component::OnAddedToGameObject Component::GetGameObject \
                         Behaviour::m* Property::self PropertyRO::self \
                         WindowManager::SizeProp Component::mAwoken

# Document all callable public declarations, including template overloads; do not
# leak private implementation details or turn internal source files into an API.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_STATIC         = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
INLINE_SIMPLE_STRUCTS  = NO

# Documentation that is useful in editor tooltips uses ///, ///< or /** ... */.
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/reference/game/GAME_DEVELOPERS.md
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES
BUILTIN_STL_SUPPORT    = YES

GENERATE_HTML          = YES
HTML_OUTPUT           = html
HTML_COLORSTYLE        = TOGGLE
HTML_COLORSTYLE_HUE    = 270
PROJECT_LOGO           = docs/reference/theme/xengine_logo_light.png
HTML_EXTRA_STYLESHEET  = docs/reference/theme/xengine.css
HTML_EXTRA_FILES       = docs/reference/theme/xengine_logo_light.png \
                         docs/reference/theme/xengine_logo_dark.png \
                         docs/reference/theme/xengine_benchmark_logo_light.png \
                         docs/reference/theme/xengine_benchmark_logo_dark.png \
                         docs/reference/theme/xengine_theme_sync.js
HTML_DYNAMIC_MENUS    = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT            = xml
HAVE_DOT              = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = engine/include
FULL_PATH_NAMES        = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
